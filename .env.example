# ---- Copy this file to .env, then paste YOUR LiteLLM key below. That's the only change. ----
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env

# WaveMaker LiteLLM gateway — one endpoint for the whole workshop.
LITELLM_BASE_URL=https://wmps-litellm.onwavemaker.com/
LITELLM_API_KEY=sk-PASTE-YOUR-OWN-KEY-HERE
LLM_MODEL_ID=gpt-5.6-terra
LLM_SMALLER_MODEL_ID=gpt-5.6-luna

# Leave tracing OFF (avoids a harmless 403). Turn on only with a real LangSmith key.
LANGSMITH_TRACING=false

# ---- Alternative: OpenRouter (solo use, no LiteLLM) ----
# Comment out the four LITELLM_* lines above and uncomment these:
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# SMART_MODEL=anthropic/claude-sonnet-4.5
# FAST_MODEL=openai/gpt-4o-mini

# ---- Optional observability keys ----
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
# LANGSMITH_PROJECT=modern-ai-stack-demo
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=https://cloud.langfuse.com
