# ---- Copy this file to .env and fill in your keys ----

# REQUIRED: your OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL model overrides (defaults are set in config.py)
FAST_MODEL=openai/gpt-4o-mini
SMART_MODEL=anthropic/claude-sonnet-4.5

# ---- Observability (free tiers) ----

# LangSmith (https://smith.langchain.com -> Settings -> API Keys)
# When these are set, LangChain/LangGraph auto-trace EVERY run. No code changes.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=modern-ai-stack-demo

# Langfuse (https://cloud.langfuse.com -> Project -> Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
