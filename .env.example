# ---- Copy this file to .env and fill in your gateway + keys ----
#
# The stack is GATEWAY-AGNOSTIC. Pick ONE of the two blocks below.

# ============ OPTION A · LiteLLM Proxy (recommended for teams) ============
# Your admin gives you a base URL + a virtual key (own budget & rate limit).
# Model names = the ALIASES your proxy exposes (ask your admin).
BASE_URL=https://your-litellm-host/v1
API_KEY=sk-your-litellm-virtual-key
SMART_MODEL=claude-sonnet
FAST_MODEL=gpt-4o-mini

# These alternative names are ALSO recognized (WaveMaker LiteLLM convention),
# so an existing team .env works without renaming:
#   LITELLM_BASE_URL / LITELLM_API_KEY / LLM_MODEL_ID / LLM_SMALLER_MODEL_ID

# ============ OPTION B · OpenRouter =======================================
# Uncomment these instead (and comment out Option A). One key, no gateway to run.
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMART_MODEL=anthropic/claude-sonnet-4.5
# FAST_MODEL=openai/gpt-4o-mini

# NOTE: embeddings always run LOCALLY (HuggingFace) — no gateway needed for RAG.


# ---- Observability (optional, free tiers) ----

# LangSmith (https://smith.langchain.com -> Settings -> API Keys)
# Leave tracing OFF until you paste a REAL key — otherwise every run throws a
# harmless 403 trying to export traces. Flip to true (with a real key) for the
# LangSmith demo (notebook 11).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=modern-ai-stack-demo

# Langfuse (https://cloud.langfuse.com -> Project -> Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
